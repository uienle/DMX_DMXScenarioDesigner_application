<Window x:Class="DMXScenarioDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DMXScenarioDesigner"
        Title="DMX Scenario Designer"
        Width="1300" Height="800" MinWidth="1000" MinHeight="600" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <!-- CHIA HÀNG ->
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="Auto"/>  
        </Grid.RowDefinitions>
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="0*"/>
        </Grid.RowDefinitions>
        
        <!-- CHIA CỘT -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="55*"/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="22*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= ROW 0 (HÀNG TRÊN - 6*) ================= -->

        <!-- Cột 0 (15*): Cây thư mục -->
        <local:DeviceTreePanel x:Name="TreePanel" Grid.Row="0" Grid.Column="0"/>

        <!-- Cột 1 (55*): Vùng thiết kế Canvas -->
        <local:DesignCanvasPanel x:Name="MainCanvasPanel" Grid.Row="0" Grid.Column="1"/>
        <!-- Cột 2 & 3 (8* + 22*): Khu vực chọn thiết bị và cấu hình (Gộp 2 cột bằng ColumnSpan="2") -->
        <local:DeviceAndConfigPanel x:Name="ConfigPanel" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"/>


        <!-- ================= ROW 1 (HÀNG DƯỚI - 4*) ================= -->

        <!-- Cột 0 (15*): Danh sách Timeline -->
        <local:TimelineListPanel x:Name="TimelinePanel" Grid.Row="1" Grid.Column="0"/>

        <!-- Cột 1 (55*): Editor Timeline -->
        <local:TimelineEditorPanel x:Name="TimelineEditor" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
        
        <!-- Cột 3 (22*): Control Bar  -->
        <local:ControlBarPanel x:Name="ControlBar" Grid.Row="1" Grid.Column="3"/>
        <!-- BÓNG MA HIỆU ỨNG (Dùng để kéo thả vào Timeline) -->
        <Canvas x:Name="GlobalEffectGhostCanvas" Grid.RowSpan="3" Grid.ColumnSpan="3" IsHitTestVisible="False" Panel.ZIndex="9999">
            <Border x:Name="EffectGhostBlock" Width="180" Height="30" Background="#A0B0C0" BorderBrush="#506070" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                <!-- ĐÃ THÊM x:Name VÀ TextTrimming -->
                <TextBlock x:Name="EffectGhostText" Text="Hiệu ứng mới" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" Padding="5,0"/>
            </Border>
        </Canvas>
        <!-- Row 2: Vùng hiển thị Frame Data -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Background="#1E1E1E" CornerRadius="4" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnExport" Content="EXPORT FRAME" Click="BtnGenerateFrame_Click" Width="120" Height="40" Margin="10" Background="#007ACC" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <TextBox x:Name="DebugHexOutput" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#2D2D2D" Foreground="#00FF00" FontFamily="Consolas" FontSize="11" Margin="5" Padding="5" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>