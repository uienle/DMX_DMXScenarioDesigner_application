<UserControl x:Class="DMXScenarioDesigner.DeviceAndConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Style tùy chỉnh để thanh Slider hiện dải màu sắc -->
        <Style x:Key="RgbSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- Lớp nền hiển thị màu Gradient -->
                            <Border Height="12" Margin="0,2" CornerRadius="6" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="#888" BorderThickness="0.5"/>
                            <!-- Thanh trượt thực tế -->
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="12" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="22*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI (8*): CHỌN THIẾT BỊ ================= -->
        <Border Grid.Column="0" Background="White" BorderBrush="#3F3F46" BorderThickness="1" Margin="5" CornerRadius="4">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="THIẾT BỊ DMX" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Top">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="0,0,0,12"/>
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="MinHeight" Value="45"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>

                    <Button Content="LED RGB" Click="DeviceButton_Click"/>
                    <Button Content="MOTOR" Click="DeviceButton_Click"/>
                    <Button Content="Kênh đơn" Click="DeviceButton_Click"/>
                    <Button Content="Khác" Click="DeviceButton_Click"/>
                </StackPanel>

                <CheckBox x:Name="ToggleGridCheckBox" Grid.Row="2" Content="Hiện lưới" IsChecked="True" 
                          Checked="ToggleGridCheckBox_Checked" Unchecked="ToggleGridCheckBox_Unchecked"
                          HorizontalAlignment="Center" Margin="0,10,0,10" Foreground="Black" Cursor="Hand"/>

                <TextBlock Grid.Row="3" Text="Click chọn và đặt vào vùng bên cạnh để lấy thiết bị" 
                           FontStyle="Italic" Foreground="#808080" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Margin="0,0,0,5"/>
            </Grid>
        </Border>

        <!-- ================= CỘT PHẢI (22*): CẤU HÌNH HIỆU ỨNG ================= -->
        <Border Grid.Column="1" Background="White" BorderBrush="#3F3F46" BorderThickness="1" Margin="5" CornerRadius="4">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CÀI ĐẶT THIẾT BỊ" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ConfigContentPanel" Visibility="Collapsed">

                        <!-- PANEL LED RGB -->
                        <StackPanel x:Name="LedConfigPanel" Visibility="Collapsed">
                            <TextBlock Text="Kiểu hiển thị:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="LedEffectComboBox" SelectionChanged="LedEffectComboBox_SelectionChanged" Margin="0,0,0,15">
                                <ComboBoxItem Content="Cầu vồng (Rainbow)"/>
                                <ComboBoxItem Content="Cầu vồng quét (Rainbow Wipe)"/>
                                <ComboBoxItem Content="Chạy đuổi (Chase)"/>
                                <ComboBoxItem Content="Nhịp thở (Breathing)"/>
                                <ComboBoxItem Content="Cầu vồng nhịp thở (Rainbow Breathing)"/>
                                <ComboBoxItem Content="Quét màu (Color Wipe)"/>
                                <ComboBoxItem Content="Chớp (Strobe)"/>
                                <ComboBoxItem Content="Chuyển sắc (Gradient Shift)"/>
                                <ComboBoxItem Content="Lấp lánh (Glitter)"/>
                                <ComboBoxItem Content="Sao băng (Meteor)"/>
                                <ComboBoxItem Content="Xung màu (Pulse Gradient)"/>
                                <ComboBoxItem Content="Màu tĩnh (Color)"/>
                            </ComboBox>

                            <StackPanel x:Name="ColorPickerPanel" Opacity="0.5" IsEnabled="False" Margin="0,0,0,15">
                                <TextBlock Text="Màu sắc:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="SelectedColorBox" Width="40" Height="25" Background="Red" BorderBrush="Black" BorderThickness="1" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnPickColor" Content="🖌 Chọn màu" Padding="8,4" Click="BtnPickColor_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- PANEL MOTOR -->
                        <StackPanel x:Name="MotorConfigPanel" Visibility="Collapsed">
                            <TextBlock Text="Chế độ bơm:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="MotorEffectComboBox" SelectionChanged="Config_Changed" SelectedIndex="0">
                                <ComboBoxItem Content="Đặt mức cố định (Fixed Level)" ToolTip="Tất cả motor giữ cố định ở mức Threshold (%)"/>
                                <ComboBoxItem Content="Tăng giảm đồng loạt (Global Breathing)" ToolTip="Tất cả cột nước cùng tăng giảm từ 0 → Threshold → 0"/>
                                <ComboBoxItem Content="Sóng lan truyền (Wave Sweep)" ToolTip="Các cột nước tăng giảm dạng sóng sin, lệch pha theo thứ tự vòi"/>
                                <ComboBoxItem Content="Xen kẽ đối xứng (Alternate Wave)" ToolTip="Vòi chẵn tăng thì vòi lẻ giảm và ngược lại"/>
                                <ComboBoxItem Content="Quét trái sang phải (Left To Right Sweep)" ToolTip="Đỉnh nước chạy tuần tự từ vòi đầu đến vòi cuối"/>
                                <ComboBoxItem Content="Quét giữa ra ngoài (Center Out Sweep)" ToolTip="Cột nước giữa tăng trước rồi lan dần ra hai bên"/>
                                <ComboBoxItem Content="Quét ngoài vào giữa (Edge To Center Sweep)" ToolTip="Hai biên tăng trước rồi dần hội tụ vào giữa"/>
                                <ComboBoxItem Content="Đỉnh nhọn chạy (Peak Runner)" ToolTip="Một đỉnh nước duy nhất chạy qua từng vòi"/>
                                <ComboBoxItem Content="Xòe quạt (Fountain Fan)" ToolTip="Các cột nước tạo hình quạt đối xứng, cột giữa cao nhất và các cột hai bên thấp dần. Toàn bộ hình quạt nhịp nhàng tăng giảm theo thời gian, mô phỏng hiệu ứng đài phun nước sân khấu."/>
                            </ComboBox>

                            <StackPanel x:Name="ThresholdPanel" Margin="0,0,0,15">
                                <TextBlock Text="Giá trị ngưỡng:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="ThresholdComboBox" SelectedIndex="6" SelectionChanged="Config_Changed">
                                    <ComboBoxItem Content="10%"/>
                                    <ComboBoxItem Content="20%"/>
                                    <ComboBoxItem Content="30%"/>
                                    <ComboBoxItem Content="40%"/>
                                    <ComboBoxItem Content="50%"/>
                                    <ComboBoxItem Content="60%"/>
                                    <ComboBoxItem Content="70%"/>
                                    <ComboBoxItem Content="80%"/>
                                    <ComboBoxItem Content="90%"/>
                                    <ComboBoxItem Content="100%"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- PANEL KÊNH ĐƠN / KHÁC -->
                        <StackPanel x:Name="SingleChannelConfigPanel" Visibility="Collapsed">
                            <TextBlock Text="Giá trị (0-255):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="SingleValueTextBox" Text="255" TextChanged="SingleValueTextBox_TextChanged" Margin="0,0,0,5" Padding="4"/>
                            <TextBlock x:Name="SingleValueError" Text="Giá trị không hợp lệ! Vui lòng nhập từ 0-255." Foreground="Red" Visibility="Collapsed" FontSize="11"/>
                        </StackPanel>

                        <!-- PANEL TỐC ĐỘ -->
                        <StackPanel x:Name="SpeedPanel" Margin="0,0,0,15">
                            <TextBlock Text="Tốc độ:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="SpeedComboBox" SelectedIndex="1" SelectionChanged="Config_Changed">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Thay thế nút BtnAddEffect cũ bằng StackPanel chứa 2 nút -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">

                   

                    <!-- NÚT THÊM HIỆU ỨNG CŨ -->
                    <Button x:Name="BtnAddEffect" Content="Thêm vào Timeline" Padding="15,12" FontSize="16" MinHeight="45" 
                            Background="White" Foreground="Black" BorderBrush="Black" BorderThickness="1" IsEnabled="False" Click="BtnAddEffect_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="1.0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- POPUP CHỌN MÀU (COLOR PICKER) -->
        <Popup x:Name="ColorPickerPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnPickColor}" Placement="Bottom">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Bảng màu" FontWeight="Bold" Margin="0,0,0,10"/>
                    <UniformGrid Columns="5" Rows="2" Margin="0,0,0,10">
                        <Button Background="Red" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                        <Button Background="Green" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                        <Button Background="Blue" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                        <Button Background="Yellow" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                        <Button Background="Cyan" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                        <Button Background="Magenta" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                        <Button Background="White" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                        <Button Background="Orange" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                        <Button Background="Purple" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                        <Button Background="Pink" Width="25" Height="25" Margin="2" Click="PresetColor_Click"/>
                    </UniformGrid>

                    <!-- BẢNG CHỌN MÀU VỚI SLIDER GRADIENT -->
                    <Grid Margin="0,0,0,10" Width="240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Slider Red -->
                        <TextBlock Text="R:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,8" Foreground="Red" FontWeight="Bold"/>
                        <Slider x:Name="SliderR" Grid.Row="0" Grid.Column="1" Style="{StaticResource RgbSliderStyle}" Value="255" Margin="5,0,5,8" ValueChanged="ColorSlider_ValueChanged">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="Red" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <TextBox x:Name="TxtR" Grid.Row="0" Grid.Column="2" Text="255" TextChanged="RgbTextBox_TextChanged" Margin="0,0,0,8" Padding="2" TextAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Slider Green -->
                        <TextBlock Text="G:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,8" Foreground="Green" FontWeight="Bold"/>
                        <Slider x:Name="SliderG" Grid.Row="1" Grid.Column="1" Style="{StaticResource RgbSliderStyle}" Value="0" Margin="5,0,5,8" ValueChanged="ColorSlider_ValueChanged">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="Lime" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <TextBox x:Name="TxtG" Grid.Row="1" Grid.Column="2" Text="0" TextChanged="RgbTextBox_TextChanged" Margin="0,0,0,8" Padding="2" TextAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Slider Blue -->
                        <TextBlock Text="B:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Blue" FontWeight="Bold"/>
                        <Slider x:Name="SliderB" Grid.Row="2" Grid.Column="1" Style="{StaticResource RgbSliderStyle}" Value="0" Margin="5,0,5,0" ValueChanged="ColorSlider_ValueChanged">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="Blue" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <TextBox x:Name="TxtB" Grid.Row="2" Grid.Column="2" Text="0" TextChanged="RgbTextBox_TextChanged" Margin="0,0,0,0" Padding="2" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Border x:Name="PreviewColorBox" Height="25" Background="Red" BorderBrush="Black" BorderThickness="1" Margin="0,0,0,10"/>
                    <Button Content="Xác nhận" Click="ConfirmColor_Click" Padding="5,4" Background="#007ACC" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>