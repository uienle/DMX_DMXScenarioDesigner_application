<UserControl x:Class="DMXScenarioDesigner.DesignCanvasPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseMove="UserControl_PreviewMouseMove"
             PreviewMouseRightButtonDown="UserControl_PreviewMouseRightButtonDown">

    <Border BorderBrush="#3F3F46" BorderThickness="1" Margin="5" ClipToBounds="True">
        <Grid>
            <!-- VÙNG CANVAS -->
            <ScrollViewer x:Name="DesignScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseDown="DesignScrollViewer_PreviewMouseDown" 
                          PreviewMouseMove="DesignScrollViewer_PreviewMouseMove" 
                          PreviewMouseUp="DesignScrollViewer_PreviewMouseUp"
                          PreviewMouseWheel="DesignScrollViewer_PreviewMouseWheel">
                <Canvas x:Name="DesignCanvas" Width="3000" Height="3000" Background="White" 
                        PreviewMouseLeftButtonDown="DesignCanvas_PreviewMouseLeftButtonDown">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1"/>
                    </Canvas.LayoutTransform>
                    <Rectangle x:Name="GridBackground" Width="3000" Height="3000" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <DrawingBrush Viewport="0,0,45,45" ViewportUnits="Absolute" TileMode="Tile">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="Transparent">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,45,45"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#A0A0A0">
                                            <GeometryDrawing.Geometry>
                                                <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="SelectionBox" Visibility="Collapsed" Stroke="#007ACC" StrokeThickness="1" Fill="#33007ACC" IsHitTestVisible="False" Panel.ZIndex="1000"/>
                </Canvas>
            </ScrollViewer>

            <TextBlock x:Name="PlaceholderText" Text="Vùng thiết kế (Kéo thả thiết bị vào đây)" Foreground="#AAAAAA" FontSize="16" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

            <!-- TOOLBAR -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="5">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.2" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnUndo" ToolTip="Hoàn tác" Width="35" Height="35" Margin="0,0,5,0" Click="BtnUndo_Click" IsEnabled="False" Background="#F0F0F0" BorderBrush="#CCCCCC" FontSize="18">↶</Button>
                    <Button x:Name="BtnRedo" ToolTip="Làm lại" Width="35" Height="35" Margin="0,0,5,0" Click="BtnRedo_Click" IsEnabled="False" Background="#F0F0F0" BorderBrush="#CCCCCC" FontSize="18">↷</Button>
                    <Rectangle Width="1" Fill="#CCCCCC" Margin="5,5,10,5"/>
                    <Button x:Name="BtnAlignHorizontal" ToolTip="Xếp ngang" Width="35" Height="35" Margin="0,0,5,0" Click="BtnAlignHorizontal_Click" IsEnabled="False" Background="#F0F0F0" BorderBrush="#CCCCCC">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#555" Margin="1"/>
                            <Ellipse Width="6" Height="6" Fill="#555" Margin="1"/>
                            <Ellipse Width="6" Height="6" Fill="#555" Margin="1"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAlignVertical" ToolTip="Xếp dọc" Width="35" Height="35" Margin="0,0,5,0" Click="BtnAlignVertical_Click" IsEnabled="False" Background="#F0F0F0" BorderBrush="#CCCCCC">
                        <StackPanel Orientation="Vertical">
                            <Ellipse Width="6" Height="6" Fill="#555" Margin="1"/>
                            <Ellipse Width="6" Height="6" Fill="#555" Margin="1"/>
                            <Ellipse Width="6" Height="6" Fill="#555" Margin="1"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAlignSquare" ToolTip="Xếp hình vuông" Width="35" Height="35" Margin="0,0,5,0" Click="BtnAlignSquare_Click" IsEnabled="False" Background="#F0F0F0" BorderBrush="#CCCCCC">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Row="0" Grid.Column="0" Width="6" Height="6" Fill="#555" Margin="1"/>
                            <Ellipse Grid.Row="0" Grid.Column="1" Width="6" Height="6" Fill="#555" Margin="1"/>
                            <Ellipse Grid.Row="1" Grid.Column="0" Width="6" Height="6" Fill="#555" Margin="1"/>
                            <Ellipse Grid.Row="1" Grid.Column="1" Width="6" Height="6" Fill="#555" Margin="1"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnAlignCircle" ToolTip="Xếp hình tròn" Width="35" Height="35" Margin="0,0,5,0" Click="BtnAlignCircle_Click" IsEnabled="False" Background="#F0F0F0" BorderBrush="#CCCCCC">
                        <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#555" Canvas.Left="9" Canvas.Top="2"/>
                            <Ellipse Width="6" Height="6" Fill="#555" Canvas.Left="16" Canvas.Top="5"/>
                            <Ellipse Width="6" Height="6" Fill="#555" Canvas.Left="16" Canvas.Top="13"/>
                            <Ellipse Width="6" Height="6" Fill="#555" Canvas.Left="9" Canvas.Top="16"/>
                            <Ellipse Width="6" Height="6" Fill="#555" Canvas.Left="2" Canvas.Top="13"/>
                            <Ellipse Width="6" Height="6" Fill="#555" Canvas.Left="2" Canvas.Top="5"/>
                        </Canvas>
                    </Button>
                 
                    <Rectangle Width="1" Fill="#CCCCCC" Margin="5,5,10,5"/>
                    <Button x:Name="BtnGroup" ToolTip="Gộp nhóm" Width="35" Height="35" Margin="0,0,5,0" Click="BtnGroup_Click" IsEnabled="False" Background="#F0F0F0" BorderBrush="#CCCCCC">
                        <TextBlock Text="🔗" FontSize="16"/>
                    </Button>
                    <Button x:Name="BtnUngroup" ToolTip="Bỏ gộp nhóm" Width="35" Height="35" Margin="0,0,5,0" Click="BtnUngroup_Click" IsEnabled="False" Background="#F0F0F0" BorderBrush="#CCCCCC">
                        <TextBlock Text="⛓️‍💥" FontSize="16"/>
                    </Button>

                    <Rectangle Width="1" Fill="#CCCCCC" Margin="5,5,10,5"/>
                    <Button x:Name="BtnDelete" ToolTip="Xóa" Width="35" Height="35" Click="BtnDelete_Click" Background="#F0F0F0" Foreground="Black" BorderBrush="#CCCCCC" IsEnabled="False" FontSize="16">🗑</Button>
                </StackPanel>
            </Border>

            <!-- DIALOG CẤU HÌNH -->
            <Grid x:Name="ConfigDialogOverlay" Visibility="Collapsed" Background="#80000000" Panel.ZIndex="1000">
                <Border Background="White" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="350">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="5" BlurRadius="10" Opacity="0.3" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="CẤU HÌNH THIẾT BỊ" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Nhập địa chỉ bắt đầu giống với địa chỉ in trên thiết bị DMX của bạn:" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Địa chỉ bắt đầu:" VerticalAlignment="Center" FontWeight="Bold" Width="100"/>
                            <TextBox x:Name="AddressInputTextBox" Width="100" Height="25" VerticalContentAlignment="Center" Padding="5,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ErrorTextBlock" Foreground="Red" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="100,0,0,15"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button Content="Hủy" Width="80" Height="30" Margin="0,0,10,0" Click="CancelConfig_Click" Background="#F0F0F0" BorderBrush="#CCCCCC"/>
                            <Button Content="Đặt thiết bị" Width="100" Height="30" Click="ConfirmConfig_Click" Background="#007ACC" Foreground="White" BorderBrush="#005A9E"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- ghost device -->
            <Canvas x:Name="GlobalGhostCanvas" IsHitTestVisible="False" Panel.ZIndex="2000">
                <Grid x:Name="GhostDevice" Width="64" Height="64" Visibility="Collapsed" Opacity="0.6">
                    <Ellipse Fill="#A0A0A0" Stroke="#505050" StrokeThickness="1"/>
                    <TextBlock x:Name="GhostDeviceName" Text="Tên" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-14,0,0" FontSize="12" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap" TextAlignment="Center" Width="55"/>
                </Grid>
            </Canvas>
        </Grid>
    </Border>
</UserControl>