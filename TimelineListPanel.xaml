<UserControl x:Class="DMXScenarioDesigner.TimelineListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="200">

    <!-- THÊM BORDER BAO NGOÀI CÙNG ĐỂ ĐỒNG BỘ VỚI EDITOR -->
    <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!-- Header -->
                <RowDefinition Height="25"/>
                <!-- Hàng trống khớp Ruler -->
                <RowDefinition Height="*"/>
                <!-- Danh sách -->
            </Grid.RowDefinitions>

            <!-- SỬA MÀU NỀN HEADER: Đổi Background thành White -->
            <Border Grid.Row="0" Background="White" BorderBrush="#D1D1D1" BorderThickness="0,0,1,1">
                <TextBlock Text="DANH SÁCH TIMELINE" VerticalAlignment="Center" HorizontalAlignment="Center" 
                           Foreground="#333333" FontWeight="Bold" FontSize="11"/>
            </Border>

            <!-- Hàng trống khớp với Ruler bên Editor -->
            <Border Grid.Row="1" Background="#F9F9F9" BorderBrush="#D1D1D1" BorderThickness="0,0,1,1"/>

            <!-- Danh sách các Track -->
            <ScrollViewer Grid.Row="2" x:Name="ListScroll" VerticalScrollBarVisibility="Hidden" ScrollChanged="ListScroll_ScrollChanged">
                <ItemsControl x:Name="TracksItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TrackBorder" Height="40" BorderBrush="#D1D1D1" BorderThickness="0,0,1,1" Background="White">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Margin="10,0">
                                        <TextBlock Text="☰" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TrackNameText" Text="{Binding TrackName}" Foreground="#333333" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                            Background="Transparent" Foreground="#FF4444" BorderThickness="0" Cursor="Hand"
                                            x:Name="DeleteBtn" Click="DeleteBtn_Click"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter TargetName="TrackBorder" Property="Background" Value="#F9F9F9"/>
                                    <Setter TargetName="TrackBorder" Property="Opacity" Value="0.5"/>
                                    <Setter TargetName="DeleteBtn" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TrackNameText" Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>